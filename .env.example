# ===========================================
# NurseOS Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/nurseos?schema=public"

# --- NextAuth ---
# CRITICAL: Must be set in production. When undefined, NextAuth generates a
# per-process random secret, causing JWT decrypt failures across serverless
# instances (Vercel) and infinite loading on OAuth callbacks.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Super Admin (initial setup) ---
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# --- Application ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="noreply@nurseos.digital"
EMAIL_REPLY_TO=""

# --- Payment (Paystack) ---
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- Uploads (S3-compatible) ---
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- PWA ---
NEXT_PUBLIC_APP_NAME="NurseOS"
NEXT_PUBLIC_APP_URL="https://nurseos.digital"
