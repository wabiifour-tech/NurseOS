// NurseOS — The Operating System for Global Nursing Care
// Prisma Schema (PostgreSQL — Neon / Vercel Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NOTE: For Neon PostgreSQL on Vercel:
//   DATABASE_URL = "postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require" (pooled connection)
//   DIRECT_URL   = same as DATABASE_URL or the direct connection string
// If DIRECT_URL is not set, Prisma falls back to DATABASE_URL for direct connections.

// ===== CORE USER & AUTH =====

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  middleName       String?
  displayName      String?
  avatarUrl        String?
  phone            String?
  countryCode      String   @default("NG")
  role             String   @default("NURSE")
  status           String   @default("ACTIVE")
  emailVerified    Boolean  @default(false)
  phoneVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  compactMode      Boolean  @default(false)
  sidebarCollapsed Boolean  @default(false)
  deletedAt        DateTime?
  facilityId       String?
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ─── Student / Lecturer academic context ───
  // Used only when facility.type is UNIVERSITY or SCHOOL_OF_NURSING
  // studentLevel: 100 | 200 | 300 | 400 | 500 (only for STUDENT role)
  // academicRole stores the original role ('LECTURER' or 'STUDENT') since both map to NURSE in DB
  studentLevel     Int?
  academicRole     String?  // 'LECTURER' | 'STUDENT' | null

  nurseProfile           NurseProfile?
  adminProfile           AdminProfile?
  patientProfile         PatientProfile?
  facility               Facility?  @relation("UserFacility", fields: [facilityId], references: [id])
  auditLogs              AuditLog[]
  notifications          Notification[]
  sessions               Session[]
  subscriptions          Subscription[]
  passwordResets         PasswordReset[]
  notificationPreferences NotificationPreference[]
  reportSchedules        ReportSchedule[]
  generatedReports       GeneratedReport[]
  sentDirectMessages     DirectMessage[]     @relation("SentDirectMessages")
  receivedDirectMessages DirectMessage[]     @relation("ReceivedDirectMessages")
  announcements          Announcement[]     @relation("AuthoredAnnouncements")
  announcementReads      AnnouncementRead[]
  sentEmails             EmailLog[]          @relation("SentEmails")
  receivedEmails         EmailLog[]          @relation("ReceivedEmails")
  recordings             Recording[]
  uploadedMaterials      CourseMaterial[]    @relation("UploadedMaterials")
  materialComments       MaterialComment[]   @relation("AuthoredMaterialComments")
  materialDownloads      MaterialDownload[]
  materialViews          MaterialView[]
  sharedMaterialsSent    SharedMaterial[]    @relation("SharedMaterialsSent")
  sharedMaterialsReceived SharedMaterial[]   @relation("SharedMaterialsReceived")

  @@index([email])
}

model NurseProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  licenseNumber      String   @unique
  licenseIssuingBody String   @default("Nursing Registration Board")
  licenseExpiryDate  DateTime
  specialization     String?
  yearsOfExperience  Int?
  currentFacilityId  String?
  blsCertified       Boolean  @default(false)
  blsCertExpiry      DateTime?
  aclsCertified      Boolean  @default(false)
  aclsCertExpiry     DateTime?
  nursingCouncil     String   @default("Nigeria")
  degree             String?
  university         String?
  graduationYear     Int?
  bio                String?
  skills             String   @default("[]")
  languages          String   @default("[\"English\"]")
  availableForConsult Boolean @default(false)
  rating             Float    @default(0)
  totalRatings       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility               Facility?         @relation("NurseFacility", fields: [currentFacilityId], references: [id])
  credentials            Credential[]
  competencies           Competency[]
  portfolioEntries       PortfolioEntry[]
  cpdRecords             CPDRecord[]
  departmentHead         Department[]      @relation("DepartmentHead")
  attendingRecords       MedicalRecord[]   @relation("AttendingNurse")
  recordedVitals         VitalSign[]       @relation("RecordedVitals")
  nursingNotes           NursingNote[]     @relation("NursingNotes")
  aiInteractions         AIInteraction[]   @relation("AIInteractions")
  verifiedMedications    MedicationOrder[] @relation("VerifiedMedications")
  outgoingReferrals      Referral[]        @relation("ReferringNurse")
  incomingReferrals      Referral[]        @relation("AcceptingNurse")
  requestedConsultations Consultation[]    @relation("RequestedConsultations")
  receivedConsultations  Consultation[]    @relation("ReceivedConsultations")
  sentMessages           ConsultationMessage[] @relation("SentMessages")
  authoredArticles       KnowledgeArticle[] @relation("AuthoredArticles")
  articleComments        ArticleComment[]  @relation("ArticleComments")
  enrollments            Enrollment[]      @relation("Enrollments")
  simulationAttempts     SimulationAttempt[] @relation("SimulationAttempts")
  appointments           Appointment[]     @relation("AppointmentNurse")

  @@index([licenseNumber])
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  facilityId  String?
  department  String?
  accessLevel Int      @default(1)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PatientProfile {
  id                       String    @id @default(cuid())
  userId                   String?   @unique
  patientId                String    @unique
  facilityId               String?   // The facility this patient belongs to (multi-tenant isolation)
  dateOfBirth              DateTime?
  gender                   String?
  bloodType                String?
  genotype                 String?
  allergies                String    @default("[]")
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  nationality              String?   @default("Nigerian")
  stateOfOrigin            String?
  lga                      String?
  religion                 String?
  occupation               String?
  insuranceProvider        String?
  insuranceNumber          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  facility       Facility?       @relation("PatientFacility", fields: [facilityId], references: [id])
  medicalRecords MedicalRecord[]
  appointments   Appointment[]
  vitals         VitalSign[]
  medications    MedicationOrder[]
  labOrders      LabOrder[]
  referrals      Referral[]
  visitHistory   VisitRecord[]
  consultations  Consultation[]

  @@index([patientId])
  @@index([facilityId])
}

// ===== FACILITY & ORGANIZATION =====

model Facility {
  id                  String   @id @default(cuid())
  name                String
  type                String
  level               String?
  address             String
  city                String
  state               String
  country             String   @default("Nigeria")
  latitude            Float?
  longitude           Float?
  phone               String?
  email               String?
  website             String?
  bedCapacity         Int?
  staffCount          Int?
  registrationNumber  String?  @unique
  accreditingBody     String?
  accreditationStatus String?  @default("PENDING")
  isVerified          Boolean  @default(false)
  isEmergencyCapable  Boolean  @default(false)
  servicesOffered     String   @default("[]")
  operatingHours      String?
  // Auto-set when facility.type is UNIVERSITY or SCHOOL_OF_NURSING at creation
  // After this date, subscription becomes mandatory (enforced via middleware)
  freeTrialEndsAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  departments       Department[]
  staff             NurseProfile[]     @relation("NurseFacility")
  patientProfiles   PatientProfile[]   @relation("PatientFacility")
  patients          MedicalRecord[]
  appointments      Appointment[]
  outgoingReferrals Referral[]         @relation("OutgoingReferrals")
  incomingReferrals Referral[]         @relation("IncomingReferrals")
  analytics         FacilityAnalytics[]
  adminProfiles     AdminProfile[]
  users             User[]          @relation("UserFacility")
  subscription     Subscription?
  diseaseSurveillance DiseaseSurveillance[]
  staffingPredictions StaffingPrediction[]
  announcements       Announcement[]     @relation("AnnouncementFacility")
  courseMaterials     CourseMaterial[]

  @@index([type, city, state])
  @@index([isVerified])
}

model Department {
  id          String   @id @default(cuid())
  facilityId  String
  name        String
  headNurseId String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility  Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  headNurse NurseProfile? @relation("DepartmentHead", fields: [headNurseId], references: [id])
  patients  MedicalRecord[]
}

// ===== MODULE 1: NurseAI =====

model MedicalRecord {
  id                      String   @id @default(cuid())
  patientId               String
  facilityId              String
  departmentId            String?
  encounterType           String
  encounterDate           DateTime @default(now())
  attendingNurseId        String?
  attendingDoctorId       String?
  chiefComplaint          String
  historyOfPresentIllness String?
  pastMedicalHistory      String?
  familyHistory           String?
  socialHistory           String?
  nursingAssessment       String?
  nursingDiagnosis        String   @default("[]")
  nursingCarePlan         String?
  interventions           String   @default("[]")
  evaluationNotes         String?
  dischargeSummary        String?
  aiSuggestions           String?
  aiConfidenceScore       Float?
  status                  String   @default("ACTIVE")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  patient        PatientProfile  @relation(fields: [patientId], references: [id])
  facility       Facility        @relation(fields: [facilityId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  attendingNurse NurseProfile?   @relation("AttendingNurse", fields: [attendingNurseId], references: [id])
  vitals         VitalSign[]
  medications    MedicationOrder[]
  labOrders      LabOrder[]
  nursingNotes   NursingNote[]
  aiInteractions AIInteraction[]

  @@index([patientId, encounterDate])
  @@index([facilityId, status])
}

model VitalSign {
  id                     String   @id @default(cuid())
  patientId              String
  recordId               String?
  recordedByNurseId      String?
  temperature            Float?
  heartRate              Int?
  respiratoryRate        Int?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  oxygenSaturation       Float?
  weight                 Float?
  height                 Float?
  bmi                    Float?
  bloodGlucose           Float?
  painScale              Int?
  consciousnessLevel     String?
  recordedAt             DateTime @default(now())
  earlyWarningScore      Float?
  isAbnormal             Boolean?
  notes                  String?
  source                 String   @default("MANUAL")

  patient       PatientProfile  @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord?  @relation(fields: [recordId], references: [id])
  recordedBy    NurseProfile?   @relation("RecordedVitals", fields: [recordedByNurseId], references: [id])

  @@index([patientId, recordedAt])
}

model NursingNote {
  id          String   @id @default(cuid())
  recordId    String
  nurseId     String
  noteType    String
  content     String
  aiGenerated Boolean  @default(false)
  aiPrompt    String?
  isSigned    Boolean  @default(false)
  signedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medicalRecord MedicalRecord @relation(fields: [recordId], references: [id])
  nurse         NurseProfile  @relation("NursingNotes", fields: [nurseId], references: [id])

  @@index([recordId, createdAt])
}

model AIInteraction {
  id              String   @id @default(cuid())
  recordId        String
  nurseId         String
  interactionType String
  userInput       String
  aiOutput        String
  aiModel         String   @default("gpt-4")
  confidenceScore Float?
  wasAccepted     Boolean?
  feedbackRating  Int?
  responseTimeMs  Int?
  createdAt       DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [recordId], references: [id])
  nurse         NurseProfile  @relation("AIInteractions", fields: [nurseId], references: [id])

  @@index([recordId])
}

model MedicationOrder {
  id                    String    @id @default(cuid())
  patientId             String
  recordId              String
  prescribedByDoctorId  String?
  verifiedByNurseId     String?
  medicationName        String
  dosage                String
  route                 String
  frequency             String
  duration              String?
  startDate             DateTime
  endDate               DateTime?
  indications           String?
  contraindications     String    @default("[]")
  drugInteractions      String?
  interactionAlerts     String?
  status                String    @default("PENDING")
  administeredAt        DateTime?
  administeredByNurseId String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  patient       PatientProfile @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord  @relation(fields: [recordId], references: [id])
  verifiedBy    NurseProfile?  @relation("VerifiedMedications", fields: [verifiedByNurseId], references: [id])

  @@index([patientId, status])
}

model LabOrder {
  id             String   @id @default(cuid())
  patientId      String
  recordId       String
  orderedBy      String
  testName       String
  testCategory   String
  specimenType   String?
  urgency        String   @default("ROUTINE")
  status         String   @default("ORDERED")
  resultValue    String?
  resultUnit     String?
  referenceRange String?
  isAbnormal     Boolean?
  resultDate     DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient       PatientProfile @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord  @relation(fields: [recordId], references: [id])

  @@index([patientId, status])
}

// ===== MODULE 2: CareGrid =====

model Referral {
  id                String   @id @default(cuid())
  patientId         String
  fromFacilityId    String?
  toFacilityId      String?
  toFacilityName    String?
  referringNurseId  String
  referringDoctorId String?
  reason            String?
  clinicalSummary   String?
  urgency           String   @default("ROUTINE")
  status            String   @default("PENDING")
  acceptedByNurseId String?
  acceptedAt        DateTime?
  patientArrived    Boolean  @default(false)
  arrivedAt         DateTime?
  outcomeNotes      String?
  feedbackRating    Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient        PatientProfile @relation(fields: [patientId], references: [id])
  fromFacility   Facility?      @relation("OutgoingReferrals", fields: [fromFacilityId], references: [id])
  toFacility     Facility?      @relation("IncomingReferrals", fields: [toFacilityId], references: [id])
  referringNurse NurseProfile   @relation("ReferringNurse", fields: [referringNurseId], references: [id])
  acceptingNurse NurseProfile?  @relation("AcceptingNurse", fields: [acceptedByNurseId], references: [id])

  @@index([fromFacilityId, status])
}

model Consultation {
  id                String   @id @default(cuid())
  requestingNurseId String
  consultingNurseId String
  patientId         String?
  recordId          String?
  consultationType  String
  subject           String
  description       String
  status            String   @default("REQUESTED")
  scheduledAt       DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  notes             String?
  recommendations   String?
  recordingUrl      String?
  transcript        String?
  aiSummary         String?
  rating            Int?
  webrtcOffer       String?
  webrtcAnswer      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requestingNurse NurseProfile    @relation("RequestedConsultations", fields: [requestingNurseId], references: [id])
  consultingNurse NurseProfile    @relation("ReceivedConsultations", fields: [consultingNurseId], references: [id])
  patient         PatientProfile? @relation(fields: [patientId], references: [id])
  messages        ConsultationMessage[]
  callSignals     CallSignal[]

  @@index([requestingNurseId, status])
}

model ConsultationMessage {
  id              String   @id @default(cuid())
  consultationId  String
  senderId        String
  content         String
  createdAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender       NurseProfile @relation("SentMessages", fields: [senderId], references: [id])

  @@index([consultationId, createdAt])
}

// ICE candidates and WebRTC signals for video/voice calls
// Persists across server restarts (unlike in-memory store)
model CallSignal {
  id              String   @id @default(cuid())
  consultationId  String
  senderId        String   // NurseProfile ID of the sender
  signalType      String   // "offer-candidate" or "answer-candidate"
  candidate       String   // JSON-stringified RTCIceCandidateInit
  consumed        Boolean  @default(false) // Mark as read after consumed by receiver
  createdAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, signalType, consumed])
  @@index([consultationId, createdAt])
}

model KnowledgeArticle {
  id            String   @id @default(cuid())
  authorId      String
  title         String
  slug          String   @unique
  category      String
  tags          String   @default("[]")
  content       String
  summary       String?
  readingTime   Int?
  evidenceLevel String?
  references    String   @default("[]")
  viewCount     Int      @default(0)
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  isPublished   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  language      String   @default("en")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   NurseProfile     @relation("AuthoredArticles", fields: [authorId], references: [id])
  comments ArticleComment[]

  @@index([category, isPublished])
  @@index([slug])
}

model ArticleComment {
  id        String   @id @default(cuid())
  articleId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  NurseProfile     @relation("ArticleComments", fields: [authorId], references: [id])

  @@index([articleId, createdAt])
}

// ===== MODULE 3: NurseAnalytics =====

model FacilityAnalytics {
  id                       String   @id @default(cuid())
  facilityId               String
  date                     DateTime @default(now())
  totalPatients            Int?
  newPatients              Int?
  totalEncounters          Int?
  avgWaitTimeMin           Float?
  avgLengthOfStay          Float?
  nurseToPatientRatio      Float?
  bedOccupancyRate         Float?
  medicationErrors         Int?
  nearMissEvents           Int?
  patientSatisfactionScore Float?
  nurseSatisfactionScore   Float?
  readmissionRate          Float?
  infectionRate            Float?
  mortalityRate            Float?
  topDiagnoses             String?
  peakHours                String?
  staffingData             String?
  aiInsights               String?
  period                   String   @default("DAILY")
  createdAt                DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, date, period])
  @@index([facilityId, date])
}

model DiseaseSurveillance {
  id                String   @id @default(cuid())
  facilityId        String
  region            String
  diseaseName       String
  caseCount         Int
  expectedRange     String
  isOutbreakAlert   Boolean  @default(false)
  alertLevel        String?
  affectedGroups    String   @default("[]")
  geographicCluster String?
  aiPrediction      String?
  reportedAt        DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([diseaseName, region, reportedAt])
}

model StaffingPrediction {
  id                   String   @id @default(cuid())
  facilityId           String
  departmentId         String?
  predictedDate        DateTime
  predictedPatientLoad Int?
  recommendedStaffing  Int?
  confidence           Float?
  factors              String?
  createdAt            DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, predictedDate])
}

// ===== MODULE 4: NurseID =====

model Credential {
  id               String   @id @default(cuid())
  nurseId          String
  credentialType   String
  credentialName   String
  issuingBody      String
  issueDate        DateTime
  expiryDate       DateTime?
  credentialNumber String?
  verificationHash String?
  isVerified       Boolean  @default(false)
  verifiedBy       String?
  verifiedAt       DateTime?
  documentUrl      String?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId, credentialType])
}

model Competency {
  id             String   @id @default(cuid())
  nurseId        String
  competencyArea String
  level          String
  assessedBy     String?
  assessedAt     DateTime?
  evidence       String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId, competencyArea])
}

model PortfolioEntry {
  id            String   @id @default(cuid())
  nurseId       String
  entryType     String
  title         String
  description   String
  url           String?
  evidenceUrls  String   @default("[]")
  impactMetrics String?
  startDate     DateTime?
  endDate       DateTime?
  isOngoing     Boolean  @default(false)
  isPublic      Boolean  @default(true)
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId, entryType])
}

model CPDRecord {
  id             String   @id @default(cuid())
  nurseId        String
  activityType   String
  title          String
  description    String
  cpdPoints      Float
  dateCompleted  DateTime
  provider       String?
  certificateUrl String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nurse NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@index([nurseId, dateCompleted])
}

// ===== MODULE 5: NurseAcademy =====

model Course {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String
  category        String
  level           String
  instructorIds   String   @default("[]")
  modules         String?
  durationMinutes Int?
  cpdPoints       Float?
  language        String   @default("en")
  tags            String   @default("[]")
  thumbnailUrl    String?
  isPublished     Boolean  @default(false)
  isFree          Boolean  @default(true)
  price           Float?
  enrollmentCount Int      @default(0)
  rating          Float    @default(0)
  totalRatings    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments      Enrollment[]
  simulations      Simulation[]
  courseModules    CourseModule[]  @relation("CourseModules")

  @@index([category, isPublished])
  @@index([slug])
}

model CourseModule {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  description     String
  order           Int
  contentType     String
  contentUrl      String?
  contentBody     String?
  videoUrl        String?
  durationMinutes Int?
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course Course @relation("CourseModules", fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model Enrollment {
  id                String    @id @default(cuid())
  courseId          String
  nurseId           String
  status            String    @default("IN_PROGRESS")
  enrolledAt        DateTime  @default(now())
  completedAt       DateTime?
  progressPercent   Int       @default(0)
  currentModuleId   String?
  lastAccessedAt    DateTime?
  certificateUrl    String?
  certificateIssued Boolean   @default(false)
  certificateNumber String?
  rating            Int?
  review            String?

  course Course        @relation(fields: [courseId], references: [id])
  nurse  NurseProfile  @relation("Enrollments", fields: [nurseId], references: [id])

  @@unique([courseId, nurseId])
  @@index([nurseId])
}

model Simulation {
  id                  String   @id @default(cuid())
  courseId            String?
  title               String
  description         String
  scenarioType        String
  difficulty          String
  patientProfile      String?
  initialPresentation String?
  decisionPoints      String?
  correctActions      String   @default("[]")
  timeLimitMinutes    Int?
  scoringCriteria     String?
  durationMinutes     Int?
  scenario            String?
  learningObjectives  String   @default("[]")
  aiFeedbackEnabled   Boolean  @default(true)
  isPublished         Boolean  @default(true)
  completionCount     Int      @default(0)
  avgScore            Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  course   Course?             @relation(fields: [courseId], references: [id])
  attempts SimulationAttempt[]

  @@index([scenarioType, difficulty])
}

model SimulationAttempt {
  id                  String   @id @default(cuid())
  simulationId        String
  nurseId             String
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  score               Float?
  maxScore            Float?
  actionsTaken        String?
  timeTakenSeconds    Int?
  aiEvaluation        String?
  strengths           String   @default("[]")
  areasForImprovement String   @default("[]")
  wouldRepeat         Boolean?

  simulation Simulation    @relation(fields: [simulationId], references: [id])
  nurse      NurseProfile  @relation("SimulationAttempts", fields: [nurseId], references: [id])

  @@index([simulationId, nurseId])
}

// ===== SHARED MODELS =====

model Appointment {
  id                String   @id @default(cuid())
  patientId         String
  facilityId        String?
  nurseId           String?
  doctorId          String?
  appointmentDate   DateTime
  durationMinutes   Int      @default(15)
  type              String
  status            String   @default("SCHEDULED")
  reason            String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient        PatientProfile @relation(fields: [patientId], references: [id])
  facility       Facility?      @relation(fields: [facilityId], references: [id])
  attendingNurse NurseProfile?  @relation("AppointmentNurse", fields: [nurseId], references: [id])

  @@index([facilityId, appointmentDate])
}

model VisitRecord {
  id          String   @id @default(cuid())
  patientId   String
  facilityId  String?
  visitDate   DateTime @default(now())
  visitType   String
  outcome     String?
  createdAt   DateTime @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId, visitDate])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([resource, resourceId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ===== SUBSCRIPTION & BILLING =====

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  facilityId        String   @unique
  plan              String   @default("FREE")   // FREE, STARTER, PRO, ENTERPRISE
  status            String   @default("ACTIVE")  // ACTIVE, EXPIRED, TRIALING, CANCELLED
  isActive          Boolean  @default(false)
  trialEndsAt       DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  startDate         DateTime?  // Alias for currentPeriodStart — when this subscription period begins
  endDate           DateTime?  // Alias for currentPeriodEnd — when this subscription period ends
  paymentMethod     String?   // BANK_TRANSFER, PAYSTACK, FLUTTERWAVE, MANUAL
  paymentReference  String?   // Transaction reference / receipt number
  amountPaid        Float?
  currency          String    @default("NGN")
  verifiedBy        String?   // Admin who verified the payment
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([userId])
  @@index([facilityId])
  @@index([status])
}

// ===== USER SETTINGS =====

// ─── Course Materials (Student Nurses Module) ───
// Lecturers upload slides / documents / PDFs / links and tag them with a level (100-500).
// Students can only view materials for their own level within their institution.
model CourseMaterial {
  id            String   @id @default(cuid())
  facilityId    String   // Institution (university / school of nursing)
  uploaderId    String   // Lecturer (User) who uploaded the file
  title         String
  description   String?
  // Type of material
  type          String   // SLIDE | DOCUMENT | POWERPOINT | PDF | LINK
  // For file uploads: relative URL/path (e.g., /uploads/materials/xxx.pdf) — base64 stored externally for now
  // For links: external URL
  fileUrl       String?
  externalUrl   String?
  fileName      String?  // Original filename
  fileSize      Int?     // Bytes
  mimeType      String?
  // Mandatory level filter — only students at this level can see the material
  level         Int      // 100 | 200 | 300 | 400 | 500
  // Optional course/subject tag
  courseCode    String?
  courseTitle   String?
  // Visibility / status
  isPublished   Boolean  @default(true)
  // Optional scheduled publish date — if set, the material is hidden from students until this date
  // (lecturer can pre-load materials and have them auto-publish on the semester start date)
  publishAt     DateTime?
  downloadCount Int      @default(0)
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  facility   Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  uploader   User               @relation("UploadedMaterials", fields: [uploaderId], references: [id], onDelete: Cascade)
  comments   MaterialComment[]
  downloads  MaterialDownload[]
  views      MaterialView[]
  shares     SharedMaterial[]

  @@index([facilityId, level])
  @@index([facilityId, level, isPublished])
  @@index([uploaderId])
  @@index([publishAt])
}

// ─── Material Comments / Q&A Thread ───
// Students can ask questions on a material; lecturers (or any academic user) can respond.
// Threaded via optional parentId (a comment with parentId=null is a top-level question).
model MaterialComment {
  id          String   @id @default(cuid())
  materialId  String
  authorId    String
  parentId    String?  // null = top-level comment/question; non-null = reply
  content     String
  // Lecturer flag — set to true when the comment author is a lecturer (for highlighting "official answer")
  isLecturerResponse Boolean @default(false)
  // Soft-resolution flag — students can mark their question as answered
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  author   User           @relation("AuthoredMaterialComments", fields: [authorId], references: [id], onDelete: Cascade)
  parent   MaterialComment? @relation("MaterialCommentReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies  MaterialComment[] @relation("MaterialCommentReply")

  @@index([materialId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

// ─── Material Download Tracking ───
// Records each download/view event with the student who triggered it.
// Used for: institution admin "who accessed what" dashboard + lecturer analytics.
model MaterialDownload {
  id          String   @id @default(cuid())
  materialId  String
  userId      String   // Student who downloaded/viewed the material
  eventType   String   @default("VIEW")  // VIEW | DOWNLOAD
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
  @@index([userId, createdAt])
  @@unique([materialId, userId, eventType])  // One record per user/event-type/material (for "first access" tracking)
}

// ─── Material View Tracking (separate from download) ───
// Lightweight view counter — one row per unique (user, material) pair.
// Updated timestamp = "last viewed at" for analytics.
model MaterialView {
  id          String   @id @default(cuid())
  materialId  String
  userId      String
  viewCount   Int      @default(1)
  lastViewedAt DateTime @default(now())
  firstViewedAt DateTime @default(now())

  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@index([materialId, lastViewedAt])
  @@index([userId])
}

// ─── Lecturer-to-Lecturer Material Sharing ───
// A lecturer can share one of their materials with another lecturer (cross-institution).
// The recipient gets read-only access to the material's file/url.
model SharedMaterial {
  id            String   @id @default(cuid())
  materialId    String   // The original material being shared
  senderId      String   // Lecturer sharing the material
  recipientId   String   // Lecturer receiving the material
  recipientEmail String  // Email at time of sharing (in case recipient hasn't signed up yet)
  message       String?  // Optional note from sender
  status        String   @default("PENDING")  // PENDING | ACCEPTED | REJECTED | EXPIRED
  // If accepted, recipient can copy this material into their own institution
  copiedToMaterialId String?  // ID of the new material created in recipient's facility (if copied)
  expiresAt     DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  material  CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  sender    User           @relation("SharedMaterialsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User           @relation("SharedMaterialsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, status])
  @@index([materialId])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String   // e.g. 'patient-alerts', 'appointment-reminders'
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model ReportSchedule {
  id         String   @id @default(cuid())
  userId     String
  templateId String   // e.g. 'monthly-summary', 'quarterly-performance'
  enabled    Boolean  @default(true)
  frequency  String   @default("Monthly") // Weekly, Monthly, Quarterly
  recipients String?  // comma-separated emails
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId])
}

model GeneratedReport {
  id          String   @id @default(cuid())
  userId      String
  facilityId  String?
  templateId  String   // e.g. 'monthly-summary', 'quarterly-performance'
  title       String
  reportType  String   // e.g. 'pdf', 'csv'
  period      String   // e.g. 'this-month', 'last-quarter'
  contentBlob String?  // Base64-encoded report content for re-download
  fileSize    Int?     // Size in bytes
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, templateId])
  @@index([userId, generatedAt])
}

// ===== MESSAGING & COMMUNICATION =====

// Direct Messages — one-to-one messages between users (intra-facility & inter-facility)
model DirectMessage {
  id         String   @id @default(cuid())
  threadKey  String   // Composite key: sorted userIds joined with "__" (e.g., "userA__userB")
  senderId   String
  recipientId String
  content    String
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  sender    User @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedDirectMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([threadKey, createdAt])
  @@index([recipientId, isRead])
  @@index([senderId])
}

// Announcements — facility-wide or system-wide broadcasts from admins
model Announcement {
  id          String   @id @default(cuid())
  authorId    String
  facilityId  String?
  title       String
  message   String
  category    String   @default("GENERAL") // GENERAL, POLICY, EMERGENCY, TRAINING, MAINTENANCE
  priority    String   @default("NORMAL")   // LOW, NORMAL, HIGH, URGENT, CRITICAL
  isPinned    Boolean  @default(false)
  isGlobal    Boolean  @default(false)
  // ─── Level-targeted announcements (academic module) ───
  // When targetScope is ALL, everyone in the facility sees the announcement.
  // When targetScope is LEVEL, only students/lecturers matching targetLevel see it.
  // When targetScope is LECTURERS, only lecturers at the facility see it.
  // When targetScope is STUDENTS, only students at the facility see it.
  targetScope String   @default("ALL")  // ALL | LEVEL | LECTURERS | STUDENTS
  targetLevel Int?     // 100 | 200 | 300 | 400 | 500 (only used when targetScope = LEVEL)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User              @relation("AuthoredAnnouncements", fields: [authorId], references: [id])
  facility  Facility?         @relation("AnnouncementFacility", fields: [facilityId], references: [id])
  reads     AnnouncementRead[]

  @@index([facilityId, createdAt])
  @@index([isGlobal, createdAt])
  @@index([priority, createdAt])
  @@index([targetScope, targetLevel])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

// ===== EMAIL LOGGING =====

model EmailLog {
  id          String   @id @default(cuid())
  senderId    String   // User who sent the email (admin/super_admin)
  recipientId String   // User who received the email
  toEmail     String   // Recipient email address
  fromEmail   String   // Sender email address
  subject     String   // Email subject line
  templateId  String?  // Template used (e.g. 'password-reset', 'user-approved')
  status      String   @default("PENDING")  // PENDING, SENT, DELIVERED, FAILED, BOUNCED
  providerId  String?  // Resend email ID for tracking
  error       String?  // Error message if failed
  metadata    String?  // JSON string for additional data (template vars, etc.)
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  sender    User @relation("SentEmails", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedEmails", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([status])
  @@index([templateId])
}

// ===== SCREEN RECORDING =====

model Recording {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  description String?
  duration    Int?     // Duration in seconds
  fileSize    Int?     // Size in bytes
  format      String   @default("webm")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
