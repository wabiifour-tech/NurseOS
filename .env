DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Email Service (Resend) ───
# 1. Create free account at https://resend.com (100 emails/day free)
# 2. Add & verify your domain (nurseos.digital) in Resend dashboard
# 3. Generate API key at https://resend.com/api-keys
# 4. Paste the key below
RESEND_API_KEY=re_your_api_key_here

# Sender email address (must be a verified domain in Resend)
# For testing before domain verification, use: onboarding@resend.dev
EMAIL_FROM=NurseOS <onboarding@resend.dev>

# Reply-to email address
EMAIL_REPLY_TO=support@nurseos.digital

# Site URL used in email templates
NEXT_PUBLIC_SITE_URL=https://www.nurseos.digital
